<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo Sale Order for Approval Workflow -->
        <record id="demo_sale_order_1" model="sale.order">
            <field name="partner_id" ref="base.res_partner_1"/>
            <field name="date_order" eval="datetime.now()"/>
            <field name="state">draft</field>
            <field name="order_line" eval="[
                (0, 0, {
                    'product_id': ref('product.product_product_1'),
                    'product_uom_qty': 10,
                    'price_unit': 100.0,
                })
            ]"/>
        </record>
    </data>
</odoo>
