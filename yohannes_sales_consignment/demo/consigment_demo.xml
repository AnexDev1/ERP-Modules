<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo Consignment Request -->
        <record id="demo_consignment_request_1" model="consignment.request">
            <field name="partner_id" ref="base.res_partner_2"/>
            <field name="issue_type">consignment</field>
            <field name="issue_date" eval="datetime.now()"/>
            <field name="remarks">Demo consignment request for testing.</field>
            <field name="state">draft</field>
        </record>

        <!-- Demo Consignment Line -->
        <record id="demo_consignment_line_1" model="consignment.request.line">
            <field name="request_id" ref="demo_consignment_request_1"/>
            <field name="product_id" ref="product.product_product_2"/>
            <field name="quantity_requested">5</field>
        </record>
    </data>
</odoo>
