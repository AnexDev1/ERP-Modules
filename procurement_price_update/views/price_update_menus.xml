<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action for Local Price Update -->
    <record id="action_procurement_price_update_local" model="ir.actions.act_window">
        <field name="name">Price Update</field>
        <field name="res_model">procurement.price.update</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('source_type', '=', 'local')]</field>
        <field name="context">{'default_source_type': 'local'}</field>
        <field name="search_view_id" ref="view_procurement_price_update_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Price Update for Local Procurement
            </p>
            <p>
                Define margins and update product selling prices based on Local Purchase Orders or Stock Receipts.
            </p>
        </field>
    </record>

    <!-- Action for Foreign Price Update -->
    <record id="action_procurement_price_update_foreign" model="ir.actions.act_window">
        <field name="name">Price Update</field>
        <field name="res_model">procurement.price.update</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('source_type', '=', 'foreign')]</field>
        <field name="context">{'default_source_type': 'foreign'}</field>
        <field name="search_view_id" ref="view_procurement_price_update_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Price Update for Foreign Procurement
            </p>
            <p>
                Define margins and update product selling prices based on Foreign Purchase Orders or Stock Receipts.
            </p>
        </field>
    </record>

    <!-- Menu for Local Price Update -->
    <menuitem id="menu_procurement_price_update_local"
              name="Price Update"
              parent="procurement_base.menu_local_procurement_root"
              action="action_procurement_price_update_local"
              groups="procurement_local_purchase.group_local_purchase_pr_manager,procurement_local_purchase.group_local_purchase_ceo"
              sequence="50"/>

    <!-- Menu for Foreign Price Update -->
    <menuitem id="menu_procurement_price_update_foreign"
              name="Price Update"
              parent="procurement_base.menu_foreign_purchase_root"
              action="action_procurement_price_update_foreign"
              groups="procurement_foreign_purchase.group_foreign_purchase_manager,procurement_foreign_purchase.group_foreign_purchase_ceo"
              sequence="50"/>
</odoo>
