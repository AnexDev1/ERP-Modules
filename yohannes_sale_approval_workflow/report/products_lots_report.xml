<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="products_lots">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure"/>
                    <h2 class="text-center mt-4 mb-4" style="color: black;">
                        <strong><t t-esc="price_type_label"/></strong>
                    </h2>

                    <table style="width: 100%; border-collapse: collapse; border: 1px solid black; background-color: white; color: black; margin-top: 20px;">
                        <thead style="display: table-row-group;">
                            <tr>
                                <th style="width: 5%; border: 1px solid black; padding: 8px; background-color: white;">SNO_</th>
                                <th style="width: 50%; border: 1px solid black; padding: 8px; background-color: white;">Description</th>
                                <th style="width: 15%; border: 1px solid black; padding: 8px; background-color: white;">Selling Price</th>
                                <th style="width: 15%; border: 1px solid black; padding: 8px; background-color: white;">Ex Date</th>
                                <th style="width: 15%; border: 1px solid black; padding: 8px; background-color: white;">Remark</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="products" t-as="p">
                                <t t-set="dates" t-value="p['expiry_dates_list']"/>
                                <t t-set="rowspan" t-value="len(dates) if dates else 1"/>
                                
                                <tr>
                                    <td class="text-right" t-att-rowspan="rowspan" style="border: 1px solid black; padding: 8px;"><t t-esc="p['sn']"/></td>
                                    <td t-att-rowspan="rowspan" style="border: 1px solid black; padding: 8px;"><t t-esc="p['product_name']"/></td>
                                    <td class="text-right" t-att-rowspan="rowspan" style="border: 1px solid black; padding: 8px;">
                                        <t t-esc="p['unit_price']" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black; padding: 8px;">
                                        <t t-if="dates"><t t-esc="dates[0]"/></t>
                                    </td>
                                    <td style="border: 1px solid black; padding: 8px;">&#160;</td> <!-- Remark -->
                                </tr>
                                
                                <t t-if="rowspan > 1">
                                    <t t-foreach="dates[1:]" t-as="d">
                                        <tr>
                                            <td class="text-center" style="border: 1px solid black; padding: 8px;"><t t-esc="d"/></td>
                                            <td style="border: 1px solid black; padding: 8px;">&#160;</td> <!-- Remark -->
                                        </tr>
                                    </t>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    <div class="oe_structure"/>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_products_lots" model="ir.actions.report">
        <field name="name">Products Lots Report</field>
        <field name="model">products.lots.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">yohannes_sale_approval_workflow.products_lots</field>
        <field name="report_file">yohannes_sale_approval_workflow.products_lots</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
