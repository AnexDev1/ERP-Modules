<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company record rule for Inventory Transfer -->
        <record id="rule_inventory_transfer_multi_company" model="ir.rule">
            <field name="name">Inventory Transfer: Multi Company</field>
            <field name="model_id" ref="model_inventory_transfer_custom"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Multi-company record rule for Stock Adjustment Request -->
        <record id="rule_stock_adjustment_request_multi_company" model="ir.rule">
            <field name="name">Stock Adjustment Request: Multi Company</field>
            <field name="model_id" ref="model_stock_adjustment_request"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>

</odoo>
