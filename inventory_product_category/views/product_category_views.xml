<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_category_form" model="ir.ui.view">
        <field name="name">product.category.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group name="policies" string="Category Policies">
                    <group>
                        <field name="available_in_master" widget="boolean_toggle"/>
                    </group>
                    <group>
                        <label for="batch_expiry_alert_days"/>
                        <div class="o_row">
                            <field name="batch_expiry_alert_days"/>
                            <span> Days</span>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_product_category_search" model="ir.ui.view">
        <field name="name">product.category.search</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <filter string="Available in Master" name="available_in_master" domain="[('available_in_master', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_search" model="ir.ui.view">
        <field name="name">product.template.search</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="before">
                <filter string="Available in Master" name="available_in_master" domain="[('categ_id.available_in_master', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <record id="product.product_category_action_form" model="ir.actions.act_window">
        <field name="context">{'ignore_availability': 1}</field>
    </record>

    <record id="product.product_template_action_all" model="ir.actions.act_window">
        <field name="context">{'ignore_availability': 1}</field>
    </record>

    <record id="product.product_template_action" model="ir.actions.act_window">
        <field name="context">{'search_default_filter_to_sell': 1, 'ignore_availability': 1}</field>
    </record>

    <record id="product.product_normal_action_sell" model="ir.actions.act_window">
        <field name="context">{'search_default_filter_to_sell': 1, 'ignore_availability': 1}</field>
    </record>

    <record id="stock.product_template_action_product" model="ir.actions.act_window">
        <field name="context">{'search_default_goods': 1, 'default_is_storable': True, 'ignore_availability': 1}</field>
    </record>

    <record id="stock.stock_product_normal_action" model="ir.actions.act_window">
        <field name="context">{'ignore_availability': 1}</field>
    </record>
</odoo>
