<odoo>
    <data>

        <record id="action_report_daily_sales" model="ir.actions.report">
            <field name="name">Daily Sales Report</field>
            <field name="model">daily.sales</field> <!-- ✅ Correct model -->
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">Yohannes_sales_person_target_management.report_daily_sales</field>
            <field name="report_file">Yohannes_sales_person_target_management.report_daily_sales</field>
            <field name="binding_model_id" ref="Yohannes_sales_person_target_management.model_daily_sales"/>
            <field name="print_report_name">'Daily Sales Report - %s' % (object.date.strftime("%Y-%m-%d") if object.date
                else 'Unknown')
            </field>
        </record>

    </data>
</odoo>