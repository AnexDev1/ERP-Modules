<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- After logout Odoo sets d-none on the form until a 2MB lazy JS bundle loads. -->
    <template id="login_form_visible" inherit_id="web.login">
        <xpath expr="//form[contains(@t-attf-class, 'oe_login_form')]" position="attributes">
            <attribute name="t-attf-class">oe_login_form</attribute>
        </xpath>
    </template>

    <template id="layout_skip_lazy_on_login" inherit_id="web.frontend_layout">
        <xpath expr="//t[@t-call-assets='web.assets_frontend_lazy']" position="replace">
            <t t-if="request.httprequest.path.split('?')[0] not in ('/web/login', '/web/reset_password', '/web/signup')"
               t-call-assets="web.assets_frontend_lazy" t-css="false" lazy_load="True"/>
        </xpath>
    </template>
</odoo>
