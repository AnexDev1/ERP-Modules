<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_credit_bypass" model="ir.ui.view">
        <field name="name">res.company.form.inherit.credit.bypass</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Credit Limits">
                    <group>
                        <field name="bypass_credit_limit_check"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
