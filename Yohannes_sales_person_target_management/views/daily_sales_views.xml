<odoo>
    <data>

        <record id="view_daily_sales_form" model="ir.ui.view">
            <field name="name">daily.sales.form</field>
            <field name="model">daily.sales</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="date" readonly="1"/>
                                <field name="salesperson_id" readonly="1"/>
                                <field name="cash_sales" readonly="1"/>
                                <field name="credit_sales" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_sales" readonly="1"/>
                                <field name="daily_sales_target" readonly="1"/>
                                <field name="achievement_percent" readonly="1" widget="percentage"/>
                            </group>
                        </group>
                        <!--/group-->
                        <notebook>
                            <page string="Sales Orders">>
                                <field name="sale_order_ids" readonly="1"
                                       domain="[('date_order', '&gt;=', date + ' 00:00:00'), ('date_order', '&lt;=', date + ' 23:59:59')]">
                                    <list>
                                        <field name="name"/>
                                        <field name="date_order"/>
                                        <field name="sale_type"/>
                                        <field name="amount_total"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_daily_sales_list" model="ir.ui.view">
            <field name="name">daily.sales.list</field>
            <field name="model">daily.sales</field>
            <field name="arch" type="xml">
                <list string="Daily Sales Report">
                    <field name="date"/>
                    <field name="salesperson_id"/>
                    <field name="cash_sales"/>
                    <field name="credit_sales"/>
                    <field name="total_sales"/>
                    <field name="daily_sales_target"/>
                    <field name="achievement_percent" widget="percentage"/>
                </list>
            </field>
        </record>


    </data>
</odoo>