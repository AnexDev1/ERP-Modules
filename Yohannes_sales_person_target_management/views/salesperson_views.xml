<odoo>
    <data>
        <record id="view_users_form_sales_target" model="ir.ui.view">
            <field name="name">res.users.form.sales.target</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='groups_id']/.." position="before">
                    <field name="daily_sales_target" string="Daily Sales Target"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>