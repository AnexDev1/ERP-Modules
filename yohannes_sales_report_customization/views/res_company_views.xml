<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_stamp" model="ir.ui.view">
        <field name="name">res.company.form.inherit.stamp</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="stamp_signature" widget="image" options="{'size': [100, 100]}"/>
                <field name="proforma_remarks" placeholder="e.g. REMARK:- Item will be provided from stock..."/>
            </xpath>
        </field>
    </record>
</odoo>
