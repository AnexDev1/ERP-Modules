<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- CRV Tree View -->
        <record id="view_account_move_crv_tree" model="ir.ui.view">
            <field name="name">account.move.crv.tree</field>
            <field name="model">account.move.crv</field>
            <field name="arch" type="xml">
                <list string="Cash Receipt Voucher List" create="false" edit="false">
                    <field name="move_id" string="Number"/>
                    <field name="move_id" string="Invoice Partner Display Name" readonly="1" decoration-bf="1"/>
                    <field name="crv_reference"/>
                    <field name="amount" sum="Total Amount"/>
                    <field name="payment_description"/>
                    <field name="amount_word"/>
                </list>
            </field>
        </record>

        <!-- CRV Action -->
        <record id="action_crv_report" model="ir.actions.act_window">
            <field name="name">CRV List Report</field>
            <field name="res_model">account.move.crv</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_account_move_crv_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No CRV Records Found
                </p>
            </field>
        </record>

        <!-- Menu Item (under existing Reports parent) -->
        <menuitem id="menu_crv_report"
                  name="CRV List Report"
                  parent="Yohannes_sales_person_target_management.menu_accounting_reports_customers"
                  action="action_crv_report"
                  sequence="20"/>
    </data>
</odoo>
