    <record id="view_credit_payment_list" model="ir.ui.view">
        <field name="name">credit.payment.list</field>
        <field name="model">credit.payment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount" widget="monetary"/>
                <field name="invoice_id"/>
                <field name="state"/>
                <field name="payment_term_id"/>
                <field name="due_date"/>
                <field name="payment_date"/>
            </list>
        </field>
    </record>

    <record id="view_credit_payment_form" model="ir.ui.view">
        <field name="name">credit.payment.form</field>
        <field name="model">credit.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_paid" string="Mark as Paid" type="object" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="partner_id"/>
                        <field name="amount" widget="monetary"/>
                        <field name="currency_id" readonly="1"/>
                        <field name="invoice_id"/>
                        <field name="payment_id"/>
                        <field name="payment_term_id"/>
                        <field name="due_date"/>
                        <field name="payment_date"/>
                        <field name="notification_sent" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_credit_payment" model="ir.actions.act_window">
        <field name="name">Credit Payment Dates</field>
        <field name="res_model">credit.payment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_credit_payment_dates" name="Credit Payment Dates"
              parent="account.menu_finance_receivables"
              action="action_credit_payment"/>

    </data>
</odoo>