<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Account Move Form to rename native Print button to 'Print Attachment' -->
        <record id="view_move_form_direct_print_attachment" model="ir.ui.view">
            <field name="name">account.move.form.direct.print.attachment</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Rename the 1st native Print button -->
                <xpath expr="//button[@name='action_print_pdf'][1]" position="attributes">
                    <attribute name="string">Print Attachment</attribute>
                    <attribute name="icon">fa-print</attribute>
                </xpath>

                <!-- Rename the 2nd native Print button -->
                <xpath expr="//button[@name='action_print_pdf'][2]" position="attributes">
                    <attribute name="string">Print Attachment</attribute>
                    <attribute name="icon">fa-print</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
