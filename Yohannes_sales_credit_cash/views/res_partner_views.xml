<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_property_form_inherit_credit_cash" model="ir.ui.view">
        <field name="name">res.partner.property.form.inherit.credit.cash</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_receivable_id']" position="attributes">
                <attribute name="string">Account Receivable (Cash)</attribute>
                <attribute name="groups"></attribute>
            </xpath>
            <xpath expr="//field[@name='property_account_receivable_id']" position="after">
                <field name="trade_rec_credit_account_id" string="Account Receivable (Credit)"/>
            </xpath>
        </field>
    </record>
</odoo>
