<odoo>
    <data>
        <!-- Report Template for Print Dropdown -->
        <record id="action_report_invoice_custom" model="ir.actions.report">
            <field name="name">Custom Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">Yohannes_sales_person_target_management.report_invoice_custom</field>
            <field name="report_file">Yohannes_sales_person_target_management.report_invoice_custom</field>
            <field name="print_report_name">('Invoice - %s' % (object.name))</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_invoice_custom">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">

                            <div class="text-center mb-4">
                                <h3 t-if="o.sale_type == 'cash'">Cash Sales Attachment</h3>
                                <h3 t-if="o.sale_type == 'credit'">Credit Sales Attachment</h3>
                            </div>


                            <h2>Invoice
                                <span t-field="o.name"/>
                            </h2>
                            <div class="row mt-4">
                                <div class="col-6">
                                    <strong>Customer:</strong>
                                    <br/>
                                    <span t-field="o.partner_id.name"/>
                                    <br/>
                                    <t t-if="o.partner_id.street">
                                        <span t-field="o.partner_id.street"/>
                                        <br/>
                                    </t>
                                    <t t-if="o.partner_id.city">
                                        <span t-field="o.partner_id.city"/>
                                        <t t-if="o.partner_id.zip">,
                                            <span t-field="o.partner_id.zip"/>
                                        </t>
                                        <br/>
                                    </t>
                                    <t t-if="o.partner_id.country_id">
                                        <span t-field="o.partner_id.country_id.name"/>
                                        <br/>
                                    </t>
                                </div>
                                <div class="col-6">
                                    <strong>Sale Type:</strong>
                                    <span t-field="o.sale_type" t-options="{'widget': 'selection'}"/>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-6">
                                    <strong>Invoice Date:</strong>
                                    <span t-field="o.invoice_date" t-options='{"format": "MM/dd/yyyy"}'/>
                                    <strong>Order No.:</strong>
                                    <span t-field="o.order_no"/>
                                </div>
                                <div class="col-6">
                                    <strong>Salesperson:</strong>
                                    <span t-field="o.user_id"/>
                                    <strong>Fs No.:</strong>
                                    <span t-field="o.fs_no"/>
                                </div>
                            </div>
                            <table class="table table-sm mt-4">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Batch Number</th>
                                        <th>Expiration Date</th>
                                        <th>Quantity</th>
                                        <th>Unit Price</th>
                                        <th>Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.invoice_line_ids" t-as="line">
                                        <tr>
                                            <td>
                                                <span t-field="line.product_id"/>
                                            </td>
                                            <td>
                                                <span t-field="line.lot_id" t-options="{'widget': 'text'}"/>
                                            </td>
                                            <td>
                                                <span t-field="line.expiration_date"
                                                      t-options='{"format": "MM/dd/yyyy HH:mm"}'/>
                                            </td>
                                            <td>
                                                <span t-field="line.quantity"/>
                                            </td>
                                            <td>
                                                <span t-field="line.price_unit" t-options="{'widget': 'monetary'}"/>
                                            </td>
                                            <td>
                                                <span t-field="line.price_subtotal" t-options="{'widget': 'monetary'}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div class="row">
                                <div class="col-6 offset-6">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td>
                                                <strong>Untaxed Amount:</strong>
                                            </td>
                                            <td>
                                                <span t-field="o.amount_untaxed" t-options="{'widget': 'monetary'}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>Tax:</strong>
                                            </td>
                                            <td>
                                                <span t-field="o.amount_tax" t-options="{'widget': 'monetary'}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>Total:</strong>
                                            </td>
                                            <td>
                                                <span t-field="o.amount_total" t-options="{'widget': 'monetary'}"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <div class="mt-2">
                                <strong>Total Amount in Words:</strong>
                                <span t-field="o.amount_in_words"/>
                            </div>
                            <div class="mt-4">
                                <p>I received the above goods/services in good condition.
                                    _______________________________
                                </p>
                            </div>
                            <t t-if="o.memo_note">
                                <div class="mt-2">
                                    <strong>Memo / Note:</strong>
                                    <br/>
                                    <span t-field="o.memo_note"/>
                                </div>
                            </t>
                            <div class="row mt-4">
                                <div class="col-3">
                                    <strong>Prepared By: _______________</strong>
                                    <span t-field="o.prepared_by"/>
                                </div>
                                <div class="col-3">
                                    <strong>Checked By: _________________</strong>
                                    <span t-field="o.checked_by"/>
                                </div>
                                <div class="col-3">
                                    <strong>Approved By: _________________</strong>
                                    <span t-field="o.approved_by"/>
                                </div>
                                <div class="col-3">
                                    <strong>Received By: __________________</strong>
                                    <span t-field="o.received_by"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>