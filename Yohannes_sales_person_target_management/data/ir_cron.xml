<odoo>
    <data>
        <record id="ir_cron_generate_daily_sales" model="ir.cron">
            <field name="name">Generate Daily Sales Summary</field>
            <field name="model_id" ref="model_daily_sales_tracking"/>
            <field name="state">code</field>
            <field name="code">model.generate_daily_summary()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>