<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sales_discount_category" model="ir.module.category">
        <field name="name">Sales Discount</field>
        <field name="sequence">10</field>
    </record>

    <record id="sales_discount_privilege" model="res.groups.privilege">
        <field name="name">Sales Discount</field>
        <field name="category_id" ref="sales_discount_category"/>
    </record>

    <record id="group_sales_discount_user" model="res.groups">
        <field name="name">Discount User</field>
        <field name="privilege_id" ref="sales_discount_privilege"/>
    </record>

    <record id="group_sales_discount_manager" model="res.groups">
        <field name="name">Discount Manager</field>
        <field name="privilege_id" ref="sales_discount_privilege"/>
    </record>

    <!-- Multi-company Rules -->
    <record id="discount_per_sales_amount_comp_rule" model="ir.rule">
        <field name="name">Discount per Sales Amount Multi-Company</field>
        <field name="model_id" ref="model_discount_per_sales_amount"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="discount_per_quantity_order_comp_rule" model="ir.rule">
        <field name="name">Discount per Quantity Order Multi-Company</field>
        <field name="model_id" ref="model_discount_per_quantity_order"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="discount_per_customer_type_comp_rule" model="ir.rule">
        <field name="name">Discount per Customer Type Multi-Company</field>
        <field name="model_id" ref="model_discount_per_customer_type"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="discount_per_customer_and_product_comp_rule" model="ir.rule">
        <field name="name">Discount per Customer &amp; Product Multi-Company</field>
        <field name="model_id" ref="model_discount_per_customer_and_product"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>