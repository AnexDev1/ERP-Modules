<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_consignment" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.consignment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Ensure Delivery Address / partner_id is always visible for Consignment -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">False</attribute>
            </xpath>
            <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']" position="attributes">
                <attribute name="invisible">False</attribute>
                <attribute name="readonly">True</attribute>
            </xpath>
            <!-- Also target the non-groups one just in case -->
            <xpath expr="//field[@name='location_dest_id'][@groups='!stock.group_stock_multi_locations']" position="attributes">
                <attribute name="invisible">False</attribute>
                <attribute name="readonly">True</attribute>
            </xpath>
            <!-- Force Source Location (location_id) to be visible and readonly for Returns/Receipts -->
            <xpath expr="//field[@name='location_id'][@groups='stock.group_stock_multi_locations']" position="attributes">
                <attribute name="invisible">False</attribute>
                <attribute name="readonly">True</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id'][@groups='!stock.group_stock_multi_locations']" position="attributes">
                <attribute name="invisible">False</attribute>
                <attribute name="readonly">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>
