<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payroll Security Groups -->
    <record id="module_category_hr_payroll" model="ir.module.category">
        <field name="name">Payroll</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_hr_payroll_user" model="res.groups">
        <field name="name">Officer: Manage Payroll</field>
        <field name="comment">Can view and manage employee payslips, batches, and salary structures.</field>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]" />
    </record>

    <record id="group_hr_payroll_manager" model="res.groups">
        <field name="name">Manager: Payroll Administrator</field>
        <field name="comment">Full access to payroll configuration, salary rules, and all payroll data.</field>
        <field name="implied_ids" eval="[(4, ref('payroll.group_hr_payroll_user'))]" />
    </record>
</odoo>
