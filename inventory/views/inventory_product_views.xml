<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="allowed_wh_types" invisible="1"/>
                <field name="default_warehouse_id" 
                       groups="stock.group_stock_multi_warehouses" 
                       domain="allowed_wh_types and [('wh_type', 'in', allowed_wh_types)] or []"/>
            </xpath>

            <xpath expr="//page[@name='general_information']/group" position="after">
                <group name="product_type_container" string="Product Type">
                    <field name="is_active_product" widget="boolean_toggle"/>
                    <field name="product_type"/>
                </group>
                <group name="sourcing_and_storage" string="Storage &amp; Compliance">
                    <!-- <field name="storage_condition" widget="priority"/> -->
                    <field name="procurement_source" widget="radio"/>
                    <field name="preferred_source" widget="radio" 
                           invisible="procurement_source != 'both'"
                           required="procurement_source == 'both'"/>
                    <!-- <field name="is_consignment_item" widget="boolean_toggle"/> -->
                    <field name="specification" placeholder="Enter company-specific details..."/>
                </group>
                <group name="stock_analysis" string="Company Stock Analysis">
                    <label for="avg_monthly_consumption"/>
                    <div class="o_row">
                        <field name="avg_monthly_consumption" readonly="1"/>
                        <span> Units / Month</span>
                    </div>
                    <label for="emergency_order_point"/>
                    <div class="o_row">
                        <field name="emergency_order_point"/>
                        <span> Months (Min Coverage)</span>
                    </div>
                    <label for="max_stock_level"/>
                    <div class="o_row">
                        <field name="max_stock_level"/>
                        <span> Months (Max Coverage)</span>
                    </div>
                    <field name="pharmacy_list_price" widget="monetary" invisible="product_type != 'wholesale'"/>
                </group>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="expiry_status" invisible="1"/>
            </xpath>

            <xpath expr="//notebook" position="inside">

            </xpath>
        </field>
    </record>

    <record id="view_product_template_tree" model="ir.ui.view">
        <field name="name">product.template.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">qty_available desc, default_code, name, id</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="stock_status" widget="badge" 
                        decoration-danger="stock_status == 'under'" 
                        decoration-success="stock_status == 'healthy'" 
                        decoration-warning="stock_status == 'over'"
                        optional="show"/>
                <field name="expiry_status" widget="badge"
                        decoration-danger="expiry_status == 'expired'" 
                        decoration-warning="expiry_status == 'near'" 
                        decoration-success="expiry_status == 'valid'"
                        optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_kanban" model="ir.ui.view">
        <field name="name">product.template.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_properties']" position="before">
                <div class="mt-1">
                    <field name="stock_status" widget="badge" 
                            decoration-danger="stock_status == 'under'" 
                            decoration-success="stock_status == 'healthy'" 
                            decoration-warning="stock_status == 'over'"/>
                    <field name="expiry_status" widget="badge"
                            decoration-danger="expiry_status == 'expired'" 
                            decoration-warning="expiry_status == 'near'" 
                            decoration-success="expiry_status == 'valid'"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_search" model="ir.ui.view">
        <field name="name">product.template.search</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <separator/>
                <filter string="Understock Items" name="understock" domain="[('stock_status', '=', 'under')]"/>
                <filter string="Overstock Items" name="overstock" domain="[('stock_status', '=', 'over')]"/>
                <filter string="Healthy Stock" name="healthy" domain="[('stock_status', '=', 'healthy')]"/>
                <separator/>
                <filter string="Near Expiry Items" name="near_expiry" domain="[('expiry_status', '=', 'near')]"/>
                <filter string="Expired Items" name="expired" domain="[('expiry_status', '=', 'expired')]"/>
                <separator/>
                <filter string="Import Items" name="import" domain="[('product_type', 'in', ['import', 'both'])]"/>
                <filter string="Wholesale Items" name="wholesale" domain="[('product_type', 'in', ['wholesale', 'both'])]"/>
            </xpath>
        </field>
    </record>

    <!-- Sort Inventory Stock Report by On Hand (qty_available) desc -->
    <record id="product_product_stock_tree_inherit_sort" model="ir.ui.view">
        <field name="name">product.product.stock.list.inherit.sort</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">qty_available desc, default_code, name, id</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_product_template_only_form_inherit_item_code" model="ir.ui.view">
        <field name="name">product.template.only.form.inherit.item.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Item Code</attribute>
            </xpath>
        </field>
    </record>

</odoo>

