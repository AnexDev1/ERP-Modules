<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Read-Only Tree View for Matured Customers Invoices -->
        <record id="view_matured_customers_tree" model="ir.ui.view">
            <field name="name">matured.customers.invoices.tree</field>
            <field name="model">account.move</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <!-- Disable creation and deletion entirely for this view -->
                <xpath expr="//list" position="attributes">
                    <attribute name="create">0</attribute>
                    <attribute name="edit">0</attribute>
                    <attribute name="delete">0</attribute>
                    <attribute name="import">0</attribute>
                    <attribute name="js_class"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="city" optional="show"/>
                    <field name="state_id" optional="show"/>
                    <field name="fs_no" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="tin_no" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='amount_total_in_currency_signed']" position="after">
                    <field name="sales_cost" optional="show"/>
                    <field name="core_amount" optional="show"/>
                    <field name="non_core_amount" optional="show"/>
                    <field name="total_in_birr" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Read-Only Form View for Matured Customers Invoices -->
        <record id="view_matured_customers_form" model="ir.ui.view">
            <field name="name">matured.customers.invoices.form</field>
            <field name="model">account.move</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Add a class to the form to use full width if chatter is removed -->
                <xpath expr="//form" position="attributes">
                    <attribute name="class">o_form_readonly</attribute>
                </xpath>
                <!-- Disable creation, edit, and deletion entirely for this view -->
                <xpath expr="//form" position="attributes">
                    <attribute name="create">0</attribute>
                    <attribute name="edit">0</attribute>
                    <attribute name="delete">0</attribute>
                </xpath>
                <!-- Hide the entire header (status bar, confirm, cancel buttons) -->
                <xpath expr="//header" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Hide smart buttons (like Sale Orders) -->
                <xpath expr="//div[@name='button_box']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Hide the chatter (Send message, Log note, Activity) -->
                <xpath expr="//chatter" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- Action to open Matured Customers Invoices -->
        <record id="action_matured_customers_invoices" model="ir.actions.act_window">
            <field name="name">Matured Customers</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted')]
            </field> <!-- Only posted customer invoices -->
            <field name="context">{'default_move_type': 'out_invoice'}</field>
            <field name="view_id" ref="view_matured_customers_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Track Matured Customers and Invoice Statuses
                </p>
                <p>
                    This view provides read-only access to unpaid and overdue posted invoices for tracking matured
                    customer balances.
                </p>
            </field>
        </record>

        <!-- Link the custom views directly to the action to guarantee they are used -->
        <record id="action_matured_customers_invoices_view_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_matured_customers_tree"/>
            <field name="act_window_id" ref="action_matured_customers_invoices"/>
        </record>

        <record id="action_matured_customers_invoices_view_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_matured_customers_form"/>
            <field name="act_window_id" ref="action_matured_customers_invoices"/>
        </record>

        <!-- Menu Item under Sales > Orders -->
        <menuitem id="menu_matured_customers_invoices"
                  name="Open Invoices"
                  parent="Yohannes_sales_credit_cash.menu_sale_orders_parent"
                  action="action_matured_customers_invoices"
                  groups="sales_team.group_sale_salesman"
                  active="False"
                  sequence="5"/>

    </data>
</odoo>
