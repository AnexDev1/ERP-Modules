<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Update Inventory Report list view to sort by quantity desc -->
    <record id="view_stock_quant_tree_simple_inherit_sort" model="ir.ui.view">
        <field name="name">stock.quant.list.inherit.sort</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">quantity desc</attribute>
            </xpath>
        </field>
    </record>

    <!-- Update Inventory Adjustments list view to sort by quantity desc -->
    <record id="view_stock_quant_tree_editable_inherit_sort" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.inherit.sort</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">quantity desc</attribute>
            </xpath>
        </field>
    </record>

    <!-- Restrict Apply and Apply All buttons in physical inventory to Finance Administrator -->
    <record id="view_stock_quant_tree_inventory_editable_finance" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.finance</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <!-- Apply All button in header -->
            <xpath expr="//header/button[@name='action_apply_all']" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>
            <!-- Apply button in header -->
            <xpath expr="//header/button[@name='stock.action_stock_inventory_adjustement_name']" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>
            <!-- Apply button on the line -->
            <xpath expr="//button[@name='action_apply_inventory']" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>
        </field>
    </record>
</odoo>
