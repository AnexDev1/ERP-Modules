<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Module Category -->
        <record id="sales_approval_category" model="ir.module.category">
            <field name="name">Sales Approval Workflow</field>
            <field name="sequence">10</field>
        </record>

        <!-- Privileges -->
        <record id="priv_sales_initiator" model="res.groups.privilege">
            <field name="name">Sales Initiator</field>
            <field name="category_id" ref="sales_approval_category"/>
        </record>
        <record id="priv_store_manager" model="res.groups.privilege">
            <field name="name">Store Manager</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
        </record>
        <record id="priv_price_change_approver" model="res.groups.privilege">
            <field name="name">Price Change Approver (GM/CEO)</field>
            <field name="category_id" ref="sales_approval_category"/>
        </record>
        <record id="priv_operational_manager" model="res.groups.privilege">
            <field name="name">Operational Manager (Sales Manager)</field>
            <field name="category_id" ref="sales_approval_category"/>
        </record>
        <record id="priv_finance_approver" model="res.groups.privilege">
            <field name="name">Finance Credit Approver</field>
            <field name="category_id" ref="sales_approval_category"/>
        </record>
        <record id="priv_warehouse_user" model="res.groups.privilege">
            <field name="name">Warehouse User (Delivery Prep)</field>
            <field name="category_id" ref="sales_approval_category"/>
        </record>
        <record id="priv_sales_discount_user" model="res.groups.privilege">
            <field name="name">Discount Rule User</field>
            <field name="category_id" ref="sales_approval_category"/>
        </record>
        <record id="priv_sales_discount_manager" model="res.groups.privilege">
            <field name="name">Discount Rule Manager</field>
            <field name="category_id" ref="sales_approval_category"/>
        </record>
        <record id="priv_sales_cashier" model="res.groups.privilege">
            <field name="name">Sales Cashier</field>
            <field name="category_id" ref="sales_approval_category"/>
        </record>

        <!-- Groups -->
        <!-- Sales Initiator: Sales Promoters who create quotations -->
        <record id="group_sales_initiator" model="res.groups">
            <field name="name">Sales Initiator</field>
            <field name="privilege_id" ref="priv_sales_initiator"/>
        </record>

        <record id="group_store_manager" model="res.groups">
            <field name="name">Store Manager</field>
            <field name="privilege_id" ref="priv_store_manager"/>
            <!-- Any Inventory Manager is automatically also a Store Manager -->
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
        </record>

        <!-- Price Change Approver: GM / CEO who approves discounts -->
        <record id="group_price_change_approver" model="res.groups">
            <field name="name">Price Change Approver</field>
            <field name="privilege_id" ref="priv_price_change_approver"/>
        </record>

        <!-- Operational Manager: Sales Manager who validates and confirms orders -->
        <record id="group_operational_manager" model="res.groups">
            <field name="name">Operational Manager</field>
            <field name="privilege_id" ref="priv_operational_manager"/>
        </record>

        <!-- Finance Approver: Finance Dept who approves credit terms -->
        <record id="group_finance_approver" model="res.groups">
            <field name="name">Finance Credit Approver</field>
            <field name="privilege_id" ref="priv_finance_approver"/>
        </record>

        <!-- Warehouse User: Team responsible for delivery preparation -->
        <record id="group_warehouse_user" model="res.groups">
            <field name="name">Warehouse User</field>
            <field name="privilege_id" ref="priv_warehouse_user"/>
        </record>

        <!-- Discount Rule User: can submit discount rules for approval -->
        <record id="group_sales_discount_user" model="res.groups">
            <field name="name">Discount Rule User</field>
            <field name="privilege_id" ref="priv_sales_discount_user"/>
        </record>

        <!-- Discount Rule Manager: can approve/reject discount rules -->
        <record id="group_sales_discount_manager" model="res.groups">
            <field name="name">Discount Rule Manager</field>
            <field name="privilege_id" ref="priv_sales_discount_manager"/>
        </record>

        <!-- Sales Cashier: Access strictly for invoicing -->
        <record id="group_sales_cashier" model="res.groups">
            <field name="name">Sales Cashier</field>
            <field name="privilege_id" ref="priv_sales_cashier"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <!-- Sales Price Updator: Can edit wholesale/retail prices on products -->
        <record id="priv_sales_price_updator" model="res.groups.privilege">
            <field name="name">Sales Price Updator</field>
            <field name="category_id" ref="sales_approval_category"/>
        </record>
        
        <record id="group_sales_price_updator" model="res.groups">
            <field name="name">Sales Price Updator</field>
            <field name="privilege_id" ref="priv_sales_price_updator"/>
        </record>

        <!-- Hidden setting group for Manual Discounts -->
        <record id="priv_allow_manual_discount" model="res.groups.privilege">
            <field name="name">Allow Manual Discounts</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
        
        <record id="group_allow_manual_discount" model="res.groups">
            <field name="name">Allow Manual Discounts</field>
            <field name="privilege_id" ref="priv_allow_manual_discount"/>
        </record>

    </data>
</odoo>