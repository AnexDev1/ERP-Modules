<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_withholding" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.withholding</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="withholding_certificate_no" invisible="not withholding_certificate_no"/>
            </xpath>
        </field>
    </record>
</odoo>
