<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_transaction_type_list" model="ir.ui.view">
        <field name="name">transaction.type.list</field>
        <field name="model">transaction.type</field>
        <field name="arch" type="xml">
            <list string="Transaction Types">
                <field name="short_code" string="Short Code"/>
                <field name="name" string="Transaction Type"/>
                <field name="assignment" string="Assignment"/>
                <field name="active" string="Active"/>
                <field name="company_id" string="Company" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_transaction_type_form" model="ir.ui.view">
        <field name="name">transaction.type.form</field>
        <field name="model">transaction.type</field>
        <field name="arch" type="xml">
            <form string="Transaction Type">
                <sheet>
                    <group name="header_group">
                        <group name="basic_info">
                            <field name="short_code" placeholder="e.g., WH" required="1"/>
                            <field name="assignment"/>
                            <field name="transaction_type"/>
                        </group>
                        <group name="additional_info">
                            <field name="description"/>
                            <field name="payment_method"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Posting Cycle">
                           <field name="sequence_ids">
                                <list>
                                    <field name="fiscal_year"/>
                                    <field name="sequence_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

