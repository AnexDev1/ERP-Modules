    <!-- Action -->
    <record id="action_transaction_type" model="ir.actions.act_window">
        <field name="name">Transaction Types</field>
        <field name="res_model">transaction.type</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="search_view_id" ref="view_transaction_type_search"/> -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first transaction type
            </p>
            <p>
                Transaction types help categorize different types of business transactions
                like purchases, sales, payments, and withholding.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_transaction_type"
              name="Transaction Types"
              parent="account.menu_finance_configuration"
              action="action_transaction_type"
              sequence="50"/>
</odoo>