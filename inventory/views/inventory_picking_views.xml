<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_inventory" model="ir.ui.view">
        <field name="name">stock.quant.tree.inventory</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="accounting_date" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="seq_picking" model="ir.sequence">
        <field name="name">Stock Picking Sequence</field>
        <field name="code">stock.picking.sequence</field>
        <field name="prefix"></field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
