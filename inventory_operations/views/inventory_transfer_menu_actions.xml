<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_inventory_transfer_custom" model="ir.actions.act_window">
        <field name="name">Store Transfer Requests</field>
        <field name="res_model">inventory.transfer.custom</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Store Transfer Request
            </p>
        </field>
    </record>

    <menuitem id="menu_inventory_operations" 
              name="Inventory Operations" 
              parent="stock.menu_stock_warehouse_mgmt" 
              sequence="10"/>

    <menuitem id="menu_store_transfer_requests" 
              name="Store Transfer Requests" 
              parent="menu_inventory_operations" 
              action="action_inventory_transfer_custom" 
              sequence="10"/>

    <record id="action_stock_adjustment_request" model="ir.actions.act_window">
        <field name="name">Stock Adjustment Requests</field>
        <field name="res_model">stock.adjustment.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Stock Adjustment Request
            </p>
        </field>
    </record>

    <menuitem id="menu_stock_adjustment_request" 
              name="Stock Adjustment Request" 
              parent="menu_inventory_operations" 
              action="action_stock_adjustment_request" 
              active="False"
              sequence="20"/>

</odoo>
