<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Purchase Order Line Tree View -->
        <record id="view_purchase_order_line_tree_custom" model="ir.ui.view">
            <field name="name">purchase.order.line.tree.custom</field>
            <field name="model">purchase.order.line</field>
            <field name="arch" type="xml">
                <list string="Purchase order by item" create="false" edit="false">
                    <field name="id" string="ID"/>
                    <field name="order_id" string="Order Reference"/>
                    <field name="partner_id" string="Partner"/>
                    <field name="product_id"/>
                    <field name="product_uom_id" string="Unit of Measure"/>
                    <field name="product_qty" string="Total Quantity" sum="Total Quantity"/>
                    <field name="price_unit" string="Unit Price"/>
                    <field name="price_tax" string="Tax"/>
                    <field name="price_subtotal" string="Subtotal" sum="Total Subtotal"/>
                    <field name="price_total" string="Total" sum="Total Amount"/>
                    <field name="date_order" string="Order Date" widget="datetime"/>
                </list>
            </field>
        </record>

        <!-- Purchase Order Line Action -->
        <record id="action_purchase_order_by_item" model="ir.actions.act_window">
            <field name="name">Purchase order by item</field>
            <field name="res_model">purchase.order.line</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_purchase_order_line_tree_custom"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Purchase Order Records Found
                </p>
            </field>
        </record>

        <!-- Menu Item (under existing Reports parent) -->
        <menuitem id="menu_purchase_order_by_item"
                  name="Purchase order by item"
                  parent="Yohannes_sales_person_target_management.menu_accounting_reports_customers"
                  action="action_purchase_order_by_item"
                  sequence="40"/>
    </data>
</odoo>
