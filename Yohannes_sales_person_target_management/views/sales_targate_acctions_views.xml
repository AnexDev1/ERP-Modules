<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_sales_target_config" model="ir.actions.act_window">
            <field name="name">Sales Targets</field>
            <field name="res_model">sales.target.config</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('active', '=', True)]</field>
        </record>
        <record id="action_daily_sales" model="ir.actions.act_window">
            <field name="name">Daily Sales Entries</field>
            <field name="res_model">daily.sales</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_weekly_sales" model="ir.actions.act_window">
            <field name="name">Weekly Sales</field>
            <field name="res_model">weekly.sales</field>
            <field name="view_mode">list,form</field>
        </record>


        <record id="action_monthly_sales" model="ir.actions.act_window">
            <field name="name">Monthly Sales Tracking</field>
            <field name="res_model">monthly.sales</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>