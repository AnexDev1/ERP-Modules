<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_peds" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.peds</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="peds_fiscal_printer_setting" string="PEDS Fiscal Printer" help="Configure the local PEDS API URL">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="peds_api_url" class="col-lg-3 o_light_label"/>
                            <field name="peds_api_url" class="oe_inline"/>
                        </div>
                        <div class="row mt16">
                            <label for="peds_license_keys" class="col-lg-3 o_light_label"/>
                            <field name="peds_license_keys" class="oe_inline"/>
                        </div>
                        <div class="row mt16">
                            <label for="peds_api_key" class="col-lg-3 o_light_label"/>
                            <field name="peds_api_key" class="oe_inline"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
