<odoo>
    <data>
        <template id="report_weekly_sales">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-foreach="docs" t-as="o">
                        <div class="page" style="text-align: center; margin-bottom: 20px;">
                            <h3>Weekly Sales Tracking</h3>
                        </div>
                        <table style="width: 100%; border: none;">
                            <tr>

                                <td style="font-weight: bold; padding-left: 20px;">Salesperson:
                                </td>
                                <td>
                                    <span t-field="o.salesperson_id.name"/>
                                </td>
                                <td style="font-weight: bold; padding-left: 20px;">Week Start Date:</td>
                                <td>
                                    <span t-field="o.week_start_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold; padding-left: 20px;">Week End Date:
                                </td>
                                <td>
                                    <span t-field="o.week_end_date"/>
                                </td>
                                <td style="padding-left: 20px;">Week Number:</td>
                                <td>
                                    <span t-field="o.week_number"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold;padding-left: 20px;">Weekly Target:</td>
                                <td>
                                    <span t-field="o.weekly_target"/>
                                </td>

                                <td style="padding-left: 20px;">Weekly Achievement %:</td>
                                <td>
                                    <span t-field="o.weekly_achievement_percent"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold;padding-left: 20px;">Total Cash Sales:</td>
                                <td>
                                    <span t-field="o.total_cash_sales"/>
                                </td>

                                <td style="padding-left: 20px;">Total Credit Sales:</td>
                                <td>
                                    <span t-field="o.total_credit_sales"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-left: 20px;">Total Weekly Sales:</td>
                                <td>
                                    <span t-field="o.total_sales"/>
                                </td>
                                <td style="padding-left: 20px;">Monthly Record:</td>
                                <td>
                                    <span t-field="o.monthly_sales_id"/>
                                </td>
                            </tr>
                        </table>
                        <table class="table table-bordered" style="width: 100%; margin-top: 20px;">
                            <h4 style="background-color: #f8f9fa; padding: 8px; border-left: 4px solid #dc3545;">
                                Daily sales
                            </h4>
                            <thead>
                                <tr>

                                    <th>Date</th>
                                    <th>Date Name</th>
                                    <th>Cash sales</th>
                                    <th>Credit Sales</th>
                                    <th>Total sales</th>
                                    <th>Daily Target</th>
                                    <th>Achievement</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.daily_sales_ids" t-as="line">
                                    <tr>
                                        <td>
                                            <span t-field="line.date"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.date.strftime('%A') if line.date else ''"/>
                                        </td>
                                        <td>
                                            <span t-field="line.cash_sales"/>
                                        </td>
                                        <td>
                                            <span t-field="line.credit_sales"/>
                                        </td>
                                        <td>
                                            <span t-field="line.total_sales"/>
                                        </td>
                                        <td>
                                            <span t-field="line.daily_sales_target"/>
                                        </td>
                                        <td>
                                            <span t-field="line.achievement_percent"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
