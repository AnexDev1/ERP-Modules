<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_discount_per_sales_amount_form" model="ir.ui.view">
        <field name="name">discount.per.sales.amount.form</field>
        <field name="model">discount.per.sales.amount</field>
        <field name="arch" type="xml">
            <form string="Discount Per Sales Amount">
                <header>
                    <button name="action_submit" string="Submit"
                            type="object" invisible="state != 'draft'"
                            group="yohannes_sale_approval_workflow.group_sales_discount_user"/>
                    <button name="action_approved" string="Approve"
                            type="object" invisible="state != 'submitted'"
                            group="yohannes_sale_approval_workflow.group_sales_discount_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-secondary" invisible="state !='approved'"
                            groups="yohannes_sale_approval_workflow.group_sales_discount_manager"/>
                    <field name="state" widget="statusbar"/>

                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="DPA_reference"/>
                            <field name="payment_term_id"/>
                            <field name="from_amount"/>
                            <field name="to_amount"/>
                        </group>
                        <group>
                            <field name="percentage"/>
                            <field name="company_id"/>
                            <field name="core"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_discount_per_sales_amount_list" model="ir.ui.view">
        <field name="name">discount.per.sales.amount.list</field>
        <field name="model">discount.per.sales.amount</field>
        <field name="arch" type="xml">
            <list string="Discount Per Sales Amount">
                <field name="DPA_reference"/>
                <field name="payment_term_id"/>
                <field name="from_amount"/>
                <field name="to_amount"/>
                <field name="company_id"/>
                <field name="core"/>
                <field name="state"/>
            </list>
        </field>
    </record>
</odoo>