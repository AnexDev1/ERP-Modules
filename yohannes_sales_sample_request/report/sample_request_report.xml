<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <template id="report_sample_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <div style="text-align: center; margin-bottom: 20px;">
                        <h2> Bokolu Pharmaceutical</h2>
                        <h3>Sample Request</h3>
                    </div>
                    <table style="width: 100%; border: none;">
                            <tr>
                                <td style="font-weight: bold; padding-left: 20px;">Rferance:

                                    <span t-field="o.name"/>
                                </td>
                                <td style="font-weight: bold; padding-left: 20px;">Customer:
                                    <span t-field="o.partner_id"/>
                                </td>

                            </tr>
                            <tr>
                                <td style="font-weight: bold; padding-left: 20px;">Issue Type:

                                    <span t-field="o.issue_type"/>
                                </td>
                                 <td style="padding-left: 20px;">Issue Date:
                                    <span t-field="o.issue_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold;padding-left: 20px;">Requested By:
                                    <span t-field="o.requested_by"/>
                                </td>
                            </tr>
                        </table>
                    <table class="table table-bordered" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>UOM</th>
                                <th>Requested</th>
                                <th>Issued</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.line_ids" t-as="line">
                                <tr>
                                    <td>
                                        <span t-field="line.product_id"/>
                                    </td>
                                    <td>
                                        <span t-field="line.uom_id"/>
                                    </td>
                                    <td>
                                        <span t-field="line.quantity_requested"/>
                                    </td>
                                    <td>
                                        <span t-field="line.quantity_issued"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_sample_request" model="ir.actions.report">
        <field name="name">Sample Request Printout</field>
        <field name="model">sample.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sample_request_management.report_sample_request</field>
        <field name="report_file">sample_request_management.report_sample_request</field>
        <field name="binding_model_id" ref="model_sample_request"/>
        <field name="binding_type">report</field>
    </record>
    </data>
</odoo>