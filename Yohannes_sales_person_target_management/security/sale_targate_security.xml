<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <record id="sales_target_config_category" model="ir.module.category">
        <field name="name">Sales Target</field>
        <field name="sequence">19</field>
    </record>

    <record id="sales_target_manager_privilege" model="res.groups.privilege">
        <field name="name">Sales Target Manager</field>
        <field name="category_id" ref="sales_target_config_category"/>
    </record>

    <record id="group_sales_target_manager" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="privilege_id" ref="sales_target_manager_privilege"/>
    </record>

    <!-- Multi-company Rules -->
    <record id="daily_sales_comp_rule" model="ir.rule">
        <field name="name">Daily Sales Multi-Company</field>
        <field name="model_id" ref="model_daily_sales"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="weekly_sales_comp_rule" model="ir.rule">
        <field name="name">Weekly Sales Multi-Company</field>
        <field name="model_id" ref="model_weekly_sales"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="monthly_sales_comp_rule" model="ir.rule">
        <field name="name">Monthly Sales Multi-Company</field>
        <field name="model_id" ref="model_monthly_sales"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="sales_target_config_comp_rule" model="ir.rule">
        <field name="name">Sales Target Config Multi-Company</field>
        <field name="model_id" ref="model_sales_target_config"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="sales_target_config_line_comp_rule" model="ir.rule">
        <field name="name">Sales Target Config Line Multi-Company</field>
        <field name="model_id" ref="model_sales_target_config_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    </data>
</odoo>
