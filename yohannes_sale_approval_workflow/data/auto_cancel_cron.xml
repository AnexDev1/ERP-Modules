<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_auto_cancel_uninvoiced_orders" model="ir.cron">
            <field name="name">Cancel Un-Invoiced and Proforma Orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_cancel_un_invoiced_orders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- 21:05:00 UTC is 12:05 AM in UTC+3 (East Africa/Moscow time). Odoo will auto-adjust this to the next future date -->
            <field name="nextcall">2026-08-07 21:05:00</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
