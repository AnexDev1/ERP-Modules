<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_discount_per_customer_type_form" model="ir.ui.view">
        <field name="name">discount.per.customer.type.form</field>
        <field name="model">discount.per.customer.type</field>
        <field name="arch" type="xml">
            <form string="Discount Per Customer">
                <header>
                    <button name="action_submit" string="Submit"
                            type="object" invisible="state != 'draft'"
                            group="yohannes_sale_approval_workflow.group_sales_discount_user"/>
                    <button name="action_approved" string="Approve"
                            type="object" invisible="state != 'submitted'"
                            group="yohannes_sale_approval_workflow.group_sales_discount_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-secondary" invisible="state !='approved'"
                            groups="yohannes_sale_approval_workflow.group_sales_discount_manager"/>
                    <field name="state" widget="statusbar"/>

                </header>
                <sheet>
                    <group>


                        <group>
                            <field name="DPC_reference"/>
                            <field name="category_id"/>
                            <field name="product_category_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="percentage"/>
                            <field name="core"/>
                        </group>
                    </group>
                </sheet>
                <div>
                    <chatter/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_discount_per_customer_type_list" model="ir.ui.view">
        <field name="name">discount.per.customer.type.list</field>
        <field name="model">discount.per.customer.type</field>
        <field name="arch" type="xml">
            <list string="Discount Per Customer">
                <field name="DPC_reference"/>
                <field name="category_id"/>
                <field name="product_category_id"/>
                <field name="company_id"/>
                <field name="percentage"/>
                <field name="state"/>
            </list>
        </field>
    </record>
</odoo>